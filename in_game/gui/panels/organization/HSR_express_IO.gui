# HSR 星穹列车面板 —— 使用 NCIOframe 共享 theme（P7 GUI 复用，DvT 验证通过后同步）
#
# 只保留 HSR 的叶子素材：顶部徽记、货币栏内容（ncio_currency）、底部提示卡文案。
# 其余（tab 可见性、变量栏可见性、数据动作列表、货币栏/提示卡骨架）全在 NCIOframe 的 ncio_io_theme。
# 动作按钮由 generic_actions 自动列出（show_in_gui_list 已删、icon 已补、recipient visible 已加）。
#
# 回滚：git -C StarRail checkout -- in_game/gui/panels/organization/HSR_express_IO.gui

ncio_io_theme = {
	# 顶部标志和背景
	blockoverride "organization_panel_extra_item" {
		allow_outside = yes
		flowcontainer = {
			parentanchor = top|hcenter
			icon = {
				parentanchor = top
				texture = "gfx/interface/icons/international_organizations/HSR_express_IO_coa.dds"
				texture_density = 2
				size = { 100 100 }
			}
			position = {0 -50}
		}
		tooltipwidget = {
			ContextualTooltipType = {
				blockoverride "title_icon" {
					icon = {
						texture = "gfx/interface/icons/international_organizations/HSR_express_IO.dds"
						size = { 42 42 }
					}
				}
				blockoverride "title_text" {
					text = "HSR_express_IO"
				}
				blockoverride "tooltip_content" {
					TooltipTextBlock = {
						blockoverride "text" {
							text = "HSR_express_IO_desc"
						}
					}
					TooltipTextBlock = {
						blockoverride "text" {
							text = "HSR_express_desc"
						}
					}
				}
			}
		}
	}

	# 变量栏内容（星琼）
	blockoverride "ncio_currency" {
		text_single = {
			autoresize = yes
			align = right
			raw_text = "[GetPlayer.MakeScope.GetVariable('HSR_StellarJade').GetValue]"
		}
		widget = {
			size = { 24 24 }
			icon = {
				size = { 100% 100% }
				texture = "gfx/interface/icons/international_organizations/HSR_StellarJade.dds"
			}
		}
		tooltipwidget = {
			ContextualTooltipType = {
				blockoverride "title_icon" {
					icon = {
						texture = "gfx/interface/icons/international_organizations/HSR_StellarJade.dds"
						size = { 42 42 }
					}
				}
				blockoverride "title_text" {
					text = "HSR_StellarJade"
				}
				blockoverride "tooltip_content" {
					TooltipTextBlock = {
						blockoverride "text" {
							text = "HSR_StellarJade_desc"
						}
					}
					TooltipTextBlock = {
						blockoverride "block_title" {
							text = "HSR_StellarJade_Change"
						}
						blockoverride "text" {
							text = "HSR_StellarJade_Change_Value"
						}
					}
				}
			}
		}
	}

	# 底部提示卡文案
	blockoverride "ncio_hint_title" {
		margin = { 10 0 }
		raw_text = "HSR_express_IO_hint_title"
	}
	blockoverride "ncio_hint_desc" {
		margin = { 20 10 }
		text = "HSR_express_IO_hint_desc"
		multiline = yes
		autoresize = yes
		layoutpolicy_horizontal = expanding
	}
}
