## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
## Get latest from https://github.com/github/gitignore/blob/main/VisualStudio.gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
.vs/
Generated\ Files/
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
node_modules/
__pycache__/
*.pyc

# VS Code / IDE
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# OS noise
Thumbs.db
~$*
*~

# ============ 星穹铁道 mod 专属忽略 ============

# 采集中间产物（json / 待处理素材 / 半成品）
临时文件/spills/
临时文件/*.json
临时文件/fetched_pages.json

# 美术源素材（体量大，不入库，留待用户收集；清单见 输出物清单）
/美术资源_立绘/
/美术资源_阵营LOGO/
/美术资源_图标/

# 二向箔立绘 dds（由 in_game/HSR_2DFoil.py 从 美术资源_立绘 生成，不提交）
/in_game/gfx/models/props/HSR/*_diffuse.dds

# 其它临时脚本产物
*.bak
